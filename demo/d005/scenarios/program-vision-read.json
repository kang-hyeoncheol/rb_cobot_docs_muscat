            "funcName": "rb_manipulate_sdk.vision.vision",
            "args": {
              "option": "MECHMIND_INTERFACE",
              "data": {
                "type": "CONNECT",
                "position": "EYE_IN_HAND",
                "function_code": 99,
                "timeout_sec": 10,
                "server_ip": "192.168.0.10",
