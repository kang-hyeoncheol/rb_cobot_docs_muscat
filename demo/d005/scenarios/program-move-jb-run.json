                    "MoveJ",
                    "MoveL",
                    "MoveJB",
                    "MoveLB",
                    "MoveXB"
                  ],
                  "requireParent": true
                }
              },
              {
                "method": "Point",
                "name": "program.button.point",
                "summary": "Absolute, 45.000, 0.000, 0.000, 90.000, 0.000, 90.000, 0.000",
                "funcName": "rb_manipulate_sdk.point.set_point",
                "args": {
                  "robot_model": "$parent.robot_model",
                  "move_type": "$parent.move_type",
                  "input_method": 0,
                  "pnt_para": 50,
                  "pnt_type": 0,
