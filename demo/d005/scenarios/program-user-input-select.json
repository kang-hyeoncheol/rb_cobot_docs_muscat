  "initialState": {
    "programs": [
      {
        "name": "demo_program",
        "steps": [
          {
            "method": "Variables",
            "name": "program.button.variables",
            "summary": "STRING: user_name=\"\"",
            "funcName": "rb_program_sdk.set_variables",
            "args": {
              "variables": [
                {
                  "type": "STRING",
                  "name": "user_name",
                  "init_value": "\"\""
                }
              ]
            }
          },
          {
            "method": "Variables",
            "name": "program.button.variables",
            "summary": "NUMERIC: answer=0",
            "funcName": "rb_program_sdk.set_variables",
            "args": {
              "variables": [
                {
                  "type": "NUMERIC",
                  "name": "answer",
                  "init_value": 0
                }
              ]
            }
          },
          {
            "method": "UserInput",
            "name": "program.button.userInput",
            "summary": "STRING: user_name",
            "funcName": "rb_program_sdk.user_input",
            "args": {
              "var_form": "STRING",
              "var_selection": "user_name"
            }
          },
          {
            "method": "Debug",
            "name": "program.button.debug",
            "summary": "user_name, answer",
            "funcName": "rb_program_sdk.debug_variables",
            "args": {
              "option": "DIALOG",
              "is_only_at_ui": false,
              "variables": [
                "user_name",
                "answer"
