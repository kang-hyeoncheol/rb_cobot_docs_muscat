{
  "id": "program-if-compare",
  "doc": "/manual/program/if",
  "title": "조건 바꿔 비교하기",
  "route": "/muscat/app/program",
  "initialState": {
    "programs": [
      {
        "name": "demo_program",
        "steps": [
          {
            "method": "Variables",
            "name": "program.button.variables",
            "summary": "NUMERIC: count=2",
            "funcName": "rb_program_sdk.set_variables",
            "args": {
              "variables": [
                {
                  "type": "NUMERIC",
                  "name": "count",
                  "init_value": 2
                }
              ]
            }
          },
          {
            "method": "Variables",
            "name": "program.button.variables",
            "summary": "NUMERIC: result=0",
            "funcName": "rb_program_sdk.set_variables",
            "args": {
              "variables": [
                {
                  "type": "NUMERIC",
                  "name": "result",
                  "init_value": 0
                }
              ]
            }
          },
          {
            "method": "Condition",
            "name": "program.button.condition",
            "summary": "count == 0",
            "args": {
              "condition": "count == 0",
              "condition_type": "If"
            },
            "children": [
              {
                "method": "Script",
                "name": "program.button.script",
                "summary": "result = 1",
                "funcName": "rb_program_sdk.make_script",
                "args": {
                  "mode": "GENERAL",
                  "general_contents": [
                    "result = 1"
                  ]
                },
                "extra": {
                  "notAstEval": true
                }
              }
            ],
            "extra": {
              "groupId": "g1",
              "groupFirstItem": true,
              "requireChildren": true
            }
          },
          {
            "method": "Condition",
            "name": "program.button.elif",
            "summary": "count > 0",
            "args": {
              "condition": "count > 0",
              "condition_type": "ElseIf"
            },
            "children": [
              {
                "method": "Script",
                "name": "program.button.script",
                "summary": "result = 2",
                "funcName": "rb_program_sdk.make_script",
                "args": {
                  "mode": "GENERAL",
                  "general_contents": [
                    "result = 2"
                  ]
                },
                "extra": {
                  "notAstEval": true
                }
              }
            ],
            "extra": {
              "groupId": "g1",
              "disableCopy": true
            }
          },
          {
            "method": "Condition",
            "name": "program.button.else",
            "summary": "",
            "args": {
              "condition": "",
              "condition_type": "Else"
            },
            "children": [
              {
                "method": "Script",
                "name": "program.button.script",
                "summary": "result = 3",
                "funcName": "rb_program_sdk.make_script",
                "args": {
                  "mode": "GENERAL",
                  "general_contents": [
                    "result = 3"
                  ]
                },
                "extra": {
                  "notAstEval": true
                }
              }
            ],
            "extra": {
              "groupId": "g1",
              "disableCopy": true,
              "groupLastItem": true
            }
          },
          {
            "method": "Debug",
            "name": "program.button.debug",
            "summary": "count, result",
            "funcName": "rb_program_sdk.debug_variables",
            "args": {
              "option": "DIALOG",
              "is_only_at_ui": false,
              "variables": [
                "count",
                "result"
              ],
              "pause_option": "ALL"
            }
          }
        ]
      }
    ],
    "loadedProgram": "demo_program"
  },
  "steps": [
    {
      "id": "intro",
      "title": "조건을 바꿔 비교하기",
      "text": "If 조건을 count == 2 로 바꿔 실행하고, 앞의 조건이 참일 때 어느 분기가 실행되는지 비교합니다. 이 화면의 로봇은 실제로 움직이지 않습니다."
    },
    {
      "id": "exp-intro",
      "title": "조건을 바꿔 실행하기",
      "text": "이번에는 If 조건을 count == 2 로 바꿔 봅니다. count가 2이면 If와 Else If(count > 0)가 모두 참이 되는데, 어느 분기가 실행되는지 확인합니다. 다음을 누르세요.",
      "docText": "If 조건을 `count == 2`로 바꾸면 `count`가 2일 때 If와 Else If(`count > 0`)가 모두 참이 됩니다. 이때 어느 분기가 실행되는지 확인합니다.",
      "target": {
        "css": ".ProgramTreeItem .command-text",
        "text": "조건문 (If)",
        "nth": 0
      },
      "also": [
        {
          "css": ".ProgramTreeBox"
        }
      ],
      "shot": "full"
    },
    {
      "id": "open-edit-2",
      "title": "편집 아이콘 누르기",
      "text": "트리 위쪽의 편집 아이콘을 눌러 편집 화면을 엽니다.",
      "docText": "트리 위쪽의 편집 아이콘을 누르면 오른쪽에 편집 화면이 열립니다.",
      "target": {
        "css": ".ProgramTreeBox .hstack.gap-0\\.5 button",
        "nth": 0
      },
      "advance": "click",
      "perform": [
        {
          "click": true
        }
      ],
      "shot": "full"
    },
    {
      "id": "select-item-2",
      "title": "조건문 (If) 선택",
