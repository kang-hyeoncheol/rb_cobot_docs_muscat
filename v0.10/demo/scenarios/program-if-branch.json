{
  "id": "program-if-branch",
  "doc": "/manual/program/if",
  "title": "조건문 분기 실행 확인",
  "route": "/muscat/app/program",
  "initialState": {
    "programs": [
      {
        "name": "demo_program",
        "steps": [
          {
            "method": "Variables",
            "name": "program.button.variables",
            "summary": "NUMERIC: count=2",
            "funcName": "rb_program_sdk.set_variables",
            "args": {
              "variables": [
                {
                  "type": "NUMERIC",
                  "name": "count",
                  "init_value": 2
                }
              ]
            }
          },
          {
            "method": "Variables",
            "name": "program.button.variables",
            "summary": "NUMERIC: result=0",
            "funcName": "rb_program_sdk.set_variables",
            "args": {
              "variables": [
                {
                  "type": "NUMERIC",
                  "name": "result",
                  "init_value": 0
                }
              ]
            }
          },
          {
            "method": "Condition",
            "name": "program.button.condition",
            "summary": "count == 0",
            "args": {
              "condition": "count == 0",
              "condition_type": "If"
            },
            "children": [
              {
                "method": "Script",
                "name": "program.button.script",
                "summary": "result = 1",
                "funcName": "rb_program_sdk.make_script",
                "args": {
                  "mode": "GENERAL",
                  "general_contents": [
                    "result = 1"
                  ]
                },
                "extra": {
                  "notAstEval": true
                }
              }
            ],
            "extra": {
              "groupId": "g1",
              "groupFirstItem": true,
              "requireChildren": true
            }
          },
          {
            "method": "Condition",
            "name": "program.button.elif",
            "summary": "count > 0",
            "args": {
              "condition": "count > 0",
              "condition_type": "ElseIf"
            },
            "children": [
              {
                "method": "Script",
                "name": "program.button.script",
                "summary": "result = 2",
                "funcName": "rb_program_sdk.make_script",
                "args": {
                  "mode": "GENERAL",
                  "general_contents": [
                    "result = 2"
                  ]
                },
                "extra": {
                  "notAstEval": true
                }
              }
            ],
            "extra": {
              "groupId": "g1",
              "disableCopy": true
            }
          },
          {
            "method": "Condition",
            "name": "program.button.else",
            "summary": "",
            "args": {
              "condition": "",
              "condition_type": "Else"
            },
            "children": [
              {
                "method": "Script",
                "name": "program.button.script",
                "summary": "result = 3",
                "funcName": "rb_program_sdk.make_script",
                "args": {
                  "mode": "GENERAL",
                  "general_contents": [
                    "result = 3"
                  ]
                },
                "extra": {
                  "notAstEval": true
                }
              }
            ],
            "extra": {
              "groupId": "g1",
              "disableCopy": true,
              "groupLastItem": true
            }
          },
          {
            "method": "Debug",
            "name": "program.button.debug",
            "summary": "count, result",
            "funcName": "rb_program_sdk.debug_variables",
            "args": {
              "option": "DIALOG",
              "is_only_at_ui": false,
              "variables": [
                "count",
                "result"
              ],
              "pause_option": "ALL"
            }
          }
        ]
      }
    ],
    "loadedProgram": "demo_program"
  },
  "steps": [
    {
      "id": "intro",
      "title": "조건문 분기 실행 확인",
      "text": "조건이 이미 입력된 조건문을 실행해, 어느 분기가 실행되는지 디버그 창으로 확인합니다. 이 화면의 로봇은 실제로 움직이지 않습니다."
    },
    {
      "id": "tree",
      "title": "프로그램 살펴보기",
      "text": "count는 2입니다. If의 조건은 count == 0, Else If의 조건은 count > 0 이고, Else는 조건이 없습니다. 각 분기는 result를 1, 2, 3으로 만들고, 마지막 디버그가 count와 result를 보여 줍니다. 다음을 누르세요.",
      "docText": "예제 프로그램은 `count`를 2로 두고, 조건문의 세 분기가 `result`를 각각 1, 2, 3으로 만듭니다. If의 조건은 `count == 0`, Else If의 조건은 `count > 0`이며, 마지막 디버그가 `count`와 `result`를 보여 줍니다.",
      "target": {
        "css": ".ProgramTreeBox"
      },
      "shot": "full"
    },
    {
      "id": "run-start",
      "title": "프로그램 실행",
      "text": "재생(▶) 버튼을 눌러 프로그램을 실행하세요.",
      "docText": "재생(▶) 버튼을 눌러 프로그램을 실행합니다.",
      "target": {
        "css": ".ProgramControlBtns button",
        "nth": 0
      },
      "also": [
        {
          "css": ".ProgramTreeBox"
        }
      ],
      "advance": "click",
      "perform": [
        {
          "click": true
        }
      ],
      "shot": "full"
    },
    {
      "id": "debug-dialog",
      "title": "실행된 분기 확인",
      "text": "디버그 창에 count: 2.0, result: 2.0 이 보입니다. count == 0 은 거짓이라 If를 건너뛰고, 다음으로 확인한 count > 0 이 참이라 Else If가 실행되었습니다. 처음으로 참인 분기 하나만 실행하므로 Else는 실행되지 않았습니다. Resume을 눌러 끝내세요. 왼쪽 트리에는 지금 실행 중인 명령이 노란색으로 표시됩니다.",
      "docText": "디버그 창에 `count: 2.0`, `result: 2.0`이 표시됩니다. `count == 0`이 거짓이라 If 분기는 건너뛰고, 다음으로 확인한 `count > 0`이 참이라 Else If 분기가 실행되었습니다. 처음으로 참인 분기 하나만 실행하므로 Else 분기는 실행되지 않습니다. 트리에는 지금 실행 중인 명령이 노란색으로 표시됩니다.",
      "target": {
        "css": "[role=dialog] button",
        "text": "Resume"
      },
      "also": [
        {
          "css": "[role=dialog]"
        },
        {
          "css": ".ProgramTreeBox"
        }
      ],
      "advance": "click",
      "perform": [
        {
          "click": true
        }
      ],
      "shot": "full",
      "lift": [
        {
          "css": ".ProgramTreeBox"
        }
      ]
    },
    {
      "id": "done",
      "title": "완료",
      "text": "조건을 위에서부터 차례로 확인해 처음으로 참인 Else If 분기가 실행되는 것을 디버그 창으로 확인했습니다."
    }
  ]
}
