            },
            {
              "css": ".ProgramTreeItem .command-text",
              "text": "포인트",
              "nth": 1
            }
          ]
        }
      ],
      "fill": [
        {
          "target": {
            "css": ".ManiPointCommandForm input:not([name])",
            "nth": 0
          },
          "value": "45.000",
          "replaceIf": "0.000"
        },
        {
          "target": {
            "css": ".ManiPointCommandForm input[name=pnt_para]"
          },
          "value": "50",
          "replaceIf": "100"
        }
      ]
    },
    {
      "id": "done",
      "title": "완료",
      "text": "동작 JB를 추가하고 포인트의 목표 값과 블렌드율을 정해 저장했습니다."
